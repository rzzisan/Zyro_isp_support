[Unit]
Description=Zyro Support: copy billing's online payments (webhook + PayBill) into the panel database
After=network.target postgresql.service

[Service]
Type=oneshot
User=claude-dev
WorkingDirectory=/var/www/zyro_isp_support
EnvironmentFile=/var/www/zyro_isp_support/engine/.env
Environment=PYTHONPATH=/var/www/zyro_isp_support
ExecStart=/var/www/zyro_isp_support/.venv/bin/python -m engine.online_payment_sync --days 2
TimeoutStartSec=300
