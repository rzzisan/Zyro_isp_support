[Unit]
Description=Zyro Support: send the Desk's queued WhatsApp template messages ("WhatsApp পাঠান") with each company's own number
After=network.target postgresql.service

[Service]
Type=oneshot
User=claude-dev
WorkingDirectory=/var/www/zyro_isp_support
EnvironmentFile=/var/www/zyro_isp_support/engine/.env
Environment=PYTHONPATH=/var/www/zyro_isp_support
ExecStart=/var/www/zyro_isp_support/.venv/bin/python -m engine.wa_campaign
TimeoutStartSec=3600
