[Unit]
Description=Zyro Desk: queue bill reminder SMS (N days before the customers' expire date) and wake the SMS sender
After=network.target postgresql.service

[Service]
Type=oneshot
# www-data like the panel itself: the cached config is readable for it and new log files stay writable for PHP-FPM
User=www-data
Environment=HOME=/tmp
WorkingDirectory=/var/www/zyro_isp_support/panel
ExecStart=/usr/bin/php artisan sms:bill-reminders
TimeoutStartSec=900
