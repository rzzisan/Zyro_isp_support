[Unit]
Description=Zyro Support: ask customers with an open ticket whether it is fixed, before WhatsApp's 24-hour window closes
After=network.target postgresql.service

[Service]
Type=oneshot
User=claude-dev
WorkingDirectory=/var/www/zyro_isp_support
EnvironmentFile=/var/www/zyro_isp_support/engine/.env
Environment=PYTHONPATH=/var/www/zyro_isp_support
ExecStart=/var/www/zyro_isp_support/.venv/bin/python -m engine.ticket_actions
TimeoutStartSec=300
