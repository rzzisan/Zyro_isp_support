[Unit]
Description=Zyro Support: export + binary backup of every MikroTik, then drop old backups
After=network.target postgresql.service

[Service]
Type=oneshot
User=claude-dev
Group=www-data
UMask=0027
WorkingDirectory=/var/www/zyro_isp_support
EnvironmentFile=/var/www/zyro_isp_support/engine/.env
Environment=PYTHONPATH=/var/www/zyro_isp_support
ExecStart=/var/www/zyro_isp_support/.venv/bin/python -m engine.mikrotik_backup
TimeoutStartSec=3600
