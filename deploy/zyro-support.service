[Unit]
Description=Zyro ISP Support WhatsApp webhook
After=network.target

[Service]
User=claude-dev
WorkingDirectory=/var/www/zyro_isp_support
EnvironmentFile=/var/www/zyro_isp_support/.env
ExecStart=/var/www/zyro_isp_support/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8993 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
