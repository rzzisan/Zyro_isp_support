[Unit]
Description=Zyro Desk hotline voice bot (Asterisk AudioSocket <-> Gemini Live, call recordings)
After=network.target postgresql.service asterisk.service

[Service]
User=claude-dev
SupplementaryGroups=asterisk www-data
UMask=0027
WorkingDirectory=/var/www/zyro_isp_support
EnvironmentFile=/var/www/zyro_isp_support/engine/.env
Environment=PYTHONPATH=/var/www/zyro_isp_support
Environment=PYTHONWARNINGS=ignore::DeprecationWarning
ExecStart=/var/www/zyro_isp_support/.venv/bin/python -m engine.voice_bot
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
