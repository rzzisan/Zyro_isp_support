[Unit]
Description=Zyro Desk: rebuild customers' other numbers from their history (profile phone, tickets, WhatsApp, SMS)
After=network.target postgresql.service

[Service]
Type=oneshot
# www-data like the panel itself: the cached config is readable for it and new log files stay writable for PHP-FPM
User=www-data
Environment=HOME=/tmp
WorkingDirectory=/var/www/zyro_isp_support/panel
ExecStart=/usr/bin/php artisan customers:alt-numbers
TimeoutStartSec=900
