[Unit]
Description=Zyro Support: send the Desk's queued SMS through each company's gateway, gateway balance, delivery reports
After=network.target postgresql.service

[Service]
Type=oneshot
User=claude-dev
WorkingDirectory=/var/www/zyro_isp_support
EnvironmentFile=/var/www/zyro_isp_support/engine/.env
Environment=PYTHONPATH=/var/www/zyro_isp_support
ExecStart=/var/www/zyro_isp_support/.venv/bin/python -m engine.sms
TimeoutStartSec=3600
