[Unit]
Description=Zyro Support: billing Expire Date to the pay day after a line was off (only companies with the switch on)
After=network.target postgresql.service

[Service]
Type=oneshot
User=claude-dev
WorkingDirectory=/var/www/zyro_isp_support
EnvironmentFile=/var/www/zyro_isp_support/engine/.env
Environment=PYTHONPATH=/var/www/zyro_isp_support
ExecStart=/var/www/zyro_isp_support/.venv/bin/python -m engine.expire_dates --auto
TimeoutStartSec=1800
