[Unit]
Description=Zyro Desk billing: next months' partitions + the Desk ledger copied from the billing copies (read-only)
After=network.target postgresql.service

[Service]
Type=oneshot
User=claude-dev
WorkingDirectory=/var/www/zyro_isp_support
EnvironmentFile=/var/www/zyro_isp_support/engine/.env
Environment=PYTHONPATH=/var/www/zyro_isp_support
ExecStart=/var/www/zyro_isp_support/.venv/bin/python -m engine.desk_billing --partitions --import --shadow
TimeoutStartSec=1h
