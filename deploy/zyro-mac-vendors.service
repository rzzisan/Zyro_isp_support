[Unit]
Description=Zyro Desk: refresh the MAC vendor list (router brands) from Wireshark's manuf file
After=network-online.target postgresql.service

[Service]
Type=oneshot
# www-data like the panel itself: the cached config is readable for it and new log files stay writable for PHP-FPM
User=www-data
Environment=HOME=/tmp
WorkingDirectory=/var/www/zyro_isp_support/panel
ExecStart=/usr/bin/php artisan mac-vendors:import
TimeoutStartSec=600
