[Unit]
Description=Zyro Desk billing phase 2: the "would turn off today" list at the company's disable hour + compare with billing (read-only)
After=network.target postgresql.service

[Service]
Type=oneshot
User=claude-dev
WorkingDirectory=/var/www/zyro_isp_support
EnvironmentFile=/var/www/zyro_isp_support/engine/.env
Environment=PYTHONPATH=/var/www/zyro_isp_support
ExecStart=/var/www/zyro_isp_support/.venv/bin/python -m engine.desk_billing --disable-shadow
TimeoutStartSec=20min
