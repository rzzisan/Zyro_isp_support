[Unit]
Description=Zyro Support: copy billing's SMS report (customers' SMS of the last two days) into the panel database
After=network.target postgresql.service

[Service]
Type=oneshot
User=claude-dev
WorkingDirectory=/var/www/zyro_isp_support
EnvironmentFile=/var/www/zyro_isp_support/engine/.env
Environment=PYTHONPATH=/var/www/zyro_isp_support
ExecStart=/var/www/zyro_isp_support/.venv/bin/python -m engine.customer_history --sms --days 2
TimeoutStartSec=600
