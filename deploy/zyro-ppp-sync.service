[Unit]
Description=Zyro Support: copy online PPPoE sessions from the MikroTik routers
After=network.target postgresql.service

[Service]
Type=oneshot
User=claude-dev
WorkingDirectory=/var/www/zyro_isp_support
EnvironmentFile=/var/www/zyro_isp_support/engine/.env
Environment=PYTHONPATH=/var/www/zyro_isp_support
ExecStart=/var/www/zyro_isp_support/.venv/bin/python -m engine.ppp_sync
TimeoutStartSec=110
