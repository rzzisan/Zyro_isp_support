# WhatsApp Cloud API webhook
WA_VERIFY_TOKEN=      # random string, same value goes in Meta app > WhatsApp > Configuration
META_APP_SECRET=      # Meta app > App settings > Basic > App secret (used to verify webhook signatures)
WA_ACCESS_TOKEN=      # system user token (later)
WA_PHONE_NUMBER_ID=   # later
# ISP Digital billing (read-only staff user)
ISPDIGITAL_BASE_URL=https://centurylink.ispdigital.cloud
ISPDIGITAL_USERNAME=
ISPDIGITAL_PASSWORD=
# Claude (draft replies)
ANTHROPIC_API_KEY=
BOT_MODE=shadow      # shadow = store drafts only; live = send replies (later)
# AI provider: claude or grok
AI_PROVIDER=claude
CLAUDE_MODEL=claude-opus-5-5
XAI_API_KEY=
XAI_MODEL=grok-4
